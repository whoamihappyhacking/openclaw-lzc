.PHONY: build rebuild up down

IMAGE_NAME := clawdbot:local
COMPOSE_FILE := docker-compose-lzc.yml
DOCKERFILE := Dockerfile.lzc

# 构建（直接复制本地 node_modules 和 dist）
build:
	pnpm build && pnpm ui:build
	docker build --progress=plain -t $(IMAGE_NAME) -f $(DOCKERFILE) .

# 强制重新构建（无缓存）
rebuild:
	pnpm build && pnpm ui:build
	docker build --progress=plain --no-cache -t $(IMAGE_NAME) -f $(DOCKERFILE) .

# 启动
up:
	docker compose -f $(COMPOSE_FILE) up -d

# 停止
down:
	docker compose -f $(COMPOSE_FILE) down
