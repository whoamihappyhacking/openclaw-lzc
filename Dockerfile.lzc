# ========== 构建 Tower 守护进程 ==========
FROM golang:1.26.3-bookworm AS tower-builder

WORKDIR /build
COPY openclaw-tower/ .

# 使用国内代理
ENV GOPROXY=https://goproxy.cn,direct
RUN go build -ldflags="-s -w" -o tower .

# ========== 主镜像 ==========
FROM node:26-bookworm

# 配置清华源
RUN sed -i 's|http://deb.debian.org|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources && \
    sed -i 's|http://security.debian.org|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources

# 复制预下载的 Bun 二进制
COPY scripts/bun-linux-x64/bun /usr/local/bin/bun
RUN chmod +x /usr/local/bin/bun && ln -sf /usr/local/bin/bun /usr/local/bin/bunx
ENV PATH="/usr/local/bin:${PATH}"

RUN corepack enable

# ========== 安装 Chromium 和浏览器依赖 ==========
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    chromium \
    chromium-driver \
    fonts-liberation \
    fonts-noto-color-emoji \
    fonts-noto-cjk \
    fonts-wqy-microhei \
    fonts-wqy-zenhei \
    locales \
    wget \
    unzip \
    tmux \
    sudo \
    git \
    jq \
    vim \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# 配置中文 locale
RUN sed -i '/zh_CN.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen zh_CN.UTF-8
ENV LANG=zh_CN.UTF-8
ENV LC_ALL=zh_CN.UTF-8

# 设置 Chromium 路径环境变量
ENV CHROMIUM_PATH=/usr/bin/chromium

# ========== 可选的额外 apt 包 ==========
ARG CLAWDBOT_DOCKER_APT_PACKAGES=""
RUN if [ -n "$CLAWDBOT_DOCKER_APT_PACKAGES" ]; then \
      apt-get update && \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $CLAWDBOT_DOCKER_APT_PACKAGES && \
      apt-get clean && \
      rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*; \
    fi

# ========== 复制代码到模板目录（只读，用于初始化） ==========
WORKDIR /opt/openclaw-image

# 复制 package.json 等配置文件
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc openclaw.mjs ./
COPY tsconfig.json ./tsconfig.json
COPY ui/tsconfig.json ./ui/tsconfig.json
COPY openclaw-tower/internal/web/default-config.json ./default-config.json
COPY scripts/ui.js ./scripts/ui.js
COPY ui/package.json ./ui/package.json
COPY ui/index.html ui/vite.config.ts ./ui/
COPY ui/src ./ui/src
COPY ui/public ./ui/public
COPY patches ./patches

# 复制本地 node_modules（已在宿主机安装好）
COPY node_modules ./node_modules
COPY ui/node_modules ./ui/node_modules

# 复制源码和构建产物
COPY src ./src
COPY dist ./dist
COPY docs ./docs
COPY extensions ./extensions
COPY skills ./skills
COPY assets ./assets
COPY git-hooks ./git-hooks

# UI 构建依赖 apps/shared 中的 tool-display.json（上游 macOS/iOS 共享资源）
COPY apps/shared/OpenClawKit/Sources/OpenClawKit/Resources/tool-display.json \
     ./apps/shared/OpenClawKit/Sources/OpenClawKit/Resources/tool-display.json

# 重新构建 Control UI 静态资源，避免复制到镜像的旧产物导致前端运行时异常
RUN pnpm ui:build && test -f /opt/openclaw-image/dist/control-ui/index.html

# 设置 npm 全局安装目录到持久化卷
ENV NPM_CONFIG_PREFIX=/app/npm-global
ENV PATH=/app/npm-global/bin:$PATH

# ========== 配置运行环境 ==========
WORKDIR /home/node

ENV NODE_ENV=production
ENV OPENCLAW_STATE_DIR=/home/node/.openclaw

# 配置用户权限
RUN echo "node ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    mkdir -p /home/node/.openclaw && \
    chown -R node:node /home/node

# 配置 PATH 让所有 shell 会话都能使用 openclaw 命令
RUN echo 'export NPM_CONFIG_PREFIX=/app/npm-global' > /etc/profile.d/openclaw.sh && \
    echo 'export PATH=/app/npm-global/bin:$PATH' >> /etc/profile.d/openclaw.sh && \
    chmod +x /etc/profile.d/openclaw.sh

# 配置 tmux (默认启用鼠标模式支持滚动，可通过 UI 切换)
RUN printf '%s\n' \
    'set -g mouse on' \
    'set -g history-limit 50000' \
    'set -g default-terminal "xterm-256color"' \
    > /home/node/.tmux.conf

# ========== 复制 Tower 守护进程 ==========
COPY --from=tower-builder /build/tower /usr/local/bin/tower
RUN chmod +x /usr/local/bin/tower

# 复制预配置的 workspace 文件
COPY --chown=node:node docker-workspace/ /opt/clawd-template/
COPY --chown=node:node docker-workspace/ /home/node/clawd/

# 添加启动脚本
COPY --chmod=755 <<'EOF' /usr/local/bin/clawdbot-entrypoint.sh
#!/bin/bash
set -e

# ========== 路径配置 ==========
IMAGE_DIR="/opt/openclaw-image"
NPM_GLOBAL="/app/npm-global"
OPENCLAW_DIR="$NPM_GLOBAL/lib/node_modules/openclaw"
OPENCLAW_BIN="$NPM_GLOBAL/bin/openclaw"
COPY_PROGRESS_FILE="/tmp/openclaw-entrypoint-copy-progress.json"

CONFIG_DIR="${OPENCLAW_STATE_DIR:-/home/node/.openclaw}"
CONFIG_FILE="${CONFIG_DIR}/openclaw.json"
AGENTS_MD="/home/node/clawd/AGENTS.md"

export OPENCLAW_STATE_DIR="$CONFIG_DIR"
export NPM_CONFIG_PREFIX="$NPM_GLOBAL"
export PATH="$NPM_GLOBAL/bin:$PATH"

echo "[openclaw] Running as root user..."

write_copy_progress() {
  local stage="$1"
  local copied_entries="$2"
  local total_entries="$3"
  local copied_bytes="$4"
  local total_bytes="$5"
  local percent="$6"
  local done="$7"
  local ts
  ts=$(date -u +"%Y-%m-%dT%H:%M:%S.%NZ")

  printf '{"source":"entrypoint","stage":"%s","copiedEntries":%s,"totalEntries":%s,"copiedBytes":%s,"totalBytes":%s,"percent":%s,"done":%s,"updatedAt":"%s"}\n' \
    "$stage" "$copied_entries" "$total_entries" "$copied_bytes" "$total_bytes" "$percent" "$done" "$ts" > "$COPY_PROGRESS_FILE"

  echo "[openclaw] copy progress: ${stage} ${percent}% (${copied_entries}/${total_entries}, ${copied_bytes}/${total_bytes} bytes)"
}

copy_with_progress() {
  local src="$1"
  local dst="$2"
  local stage="${3:-初始化复制 OpenClaw 安装}"
  local total_entries=0
  local total_bytes=0
  local copied_entries=0
  local copied_bytes=0
  local percent=0
  local last_percent=-1

  total_entries=$(find "$src" -mindepth 1 | wc -l | tr -d ' ')
  if [ -z "$total_entries" ] || [ "$total_entries" -le 0 ]; then
    total_entries=1
  fi

  total_bytes=$(du -sb "$src" 2>/dev/null | awk '{print $1}')
  if [ -z "$total_bytes" ] || [ "$total_bytes" -le 0 ]; then
    total_bytes=1
  fi

  write_copy_progress "$stage" 0 "$total_entries" 0 "$total_bytes" 0 false

  mkdir -p "$dst"

  cp -a "$src"/. "$dst"/ &
  local cp_pid=$!

  while kill -0 "$cp_pid" 2>/dev/null; do
    copied_bytes=$(du -sb "$dst" 2>/dev/null | awk '{print $1}')
    if [ -z "$copied_bytes" ] || [ "$copied_bytes" -lt 0 ]; then
      copied_bytes=0
    fi
    if [ "$copied_bytes" -gt "$total_bytes" ]; then
      copied_bytes=$total_bytes
    fi

    percent=$((copied_bytes * 100 / total_bytes))
    if [ "$percent" -gt 99 ]; then
      percent=99
    fi

    copied_entries=$((copied_bytes * total_entries / total_bytes))
    if [ "$copied_entries" -gt "$total_entries" ]; then
      copied_entries=$total_entries
    fi

    if [ "$percent" -ne "$last_percent" ]; then
      write_copy_progress "$stage" "$copied_entries" "$total_entries" "$copied_bytes" "$total_bytes" "$percent" false
      last_percent=$percent
    fi

    sleep 0.5
  done

  wait "$cp_pid"

  write_copy_progress "复制完成" "$total_entries" "$total_entries" "$total_bytes" "$total_bytes" 100 true
}

resolve_openclaw_entry() {
  local pkg_json="$OPENCLAW_DIR/package.json"
  local rel=""

  if [ -f "$OPENCLAW_DIR/dist/entry.js" ]; then
    echo "$OPENCLAW_DIR/dist/entry.js"
    return 0
  fi

  if [ -f "$pkg_json" ]; then
    rel=$(node -e 'const fs=require("fs");const p=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));const b=p.bin;let v="";if(typeof b==="string")v=b;else if(b&&typeof b==="object"&&typeof b.openclaw==="string")v=b.openclaw;process.stdout.write(v||"");' "$pkg_json" 2>/dev/null || true)
  fi

  if [ -n "$rel" ] && [[ "$rel" != /* ]] && [[ "$rel" != ..* ]]; then
    local candidate="$OPENCLAW_DIR/$rel"
    if [ -f "$candidate" ]; then
      if head -n 1 "$candidate" 2>/dev/null | grep -q '^#!/bin/sh'; then
        :
      else
      echo "$candidate"
      return 0
      fi
    fi
  fi

  if [ -f "$OPENCLAW_DIR/openclaw.mjs" ]; then
    if head -n 1 "$OPENCLAW_DIR/openclaw.mjs" 2>/dev/null | grep -q '^#!/bin/sh'; then
      :
    else
    echo "$OPENCLAW_DIR/openclaw.mjs"
    return 0
    fi
  fi

  return 1
}

ensure_openclaw_bin() {
  local entry
  if ! entry=$(resolve_openclaw_entry); then
    echo "[openclaw] ERROR: openclaw entrypoint not found under $OPENCLAW_DIR" >&2
    return 1
  fi

  mkdir -p "$NPM_GLOBAL/bin"
  rm -f "$OPENCLAW_BIN"
  cat > "$OPENCLAW_BIN" <<OPENCLAW_WRAP
#!/bin/sh
exec node "$entry" "\$@"
OPENCLAW_WRAP
  chmod +x "$OPENCLAW_BIN"
}

# ========== 初始化 openclaw 到持久化卷 ==========
init_openclaw() {
  # 从镜像获取版本
  local image_version=$(grep '"version"' "$IMAGE_DIR/package.json" | head -1 | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
  local image_commit=""
  local current_commit=""
  if [ -f "$IMAGE_DIR/dist/build-info.json" ]; then
    image_commit=$(jq -r '.commit // empty' "$IMAGE_DIR/dist/build-info.json" 2>/dev/null || true)
  fi

  if [ ! -f "$OPENCLAW_DIR/package.json" ]; then
    echo "[openclaw] First run, initializing from image (v$image_version)..."
    mkdir -p "$NPM_GLOBAL/lib/node_modules" "$NPM_GLOBAL/bin"
    copy_with_progress "$IMAGE_DIR" "$OPENCLAW_DIR" "初始化复制 OpenClaw 安装"
    ensure_openclaw_bin
    echo "[openclaw] Initialized successfully"
  else
    # 检查版本
    local current_version=$(grep '"version"' "$OPENCLAW_DIR/package.json" | head -1 | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
    if [ -f "$OPENCLAW_DIR/dist/build-info.json" ]; then
      current_commit=$(jq -r '.commit // empty' "$OPENCLAW_DIR/dist/build-info.json" 2>/dev/null || true)
    fi

    echo "[openclaw] Current version: $current_version (image: $image_version)"
    if [ -n "$current_commit" ] || [ -n "$image_commit" ]; then
      echo "[openclaw] Current commit: ${current_commit:-unknown} (image: ${image_commit:-unknown})"
    fi

    # 懒猫微服：这里不再自动覆盖持久化安装。
    # 同版本但 commit/hash 不一致的情况交由 Tower 检测并提示，由用户手动确认进入。
    if [ "$current_version" = "$image_version" ]; then
      if [ -n "$current_commit" ] && [ -n "$image_commit" ] && [ "$current_commit" != "$image_commit" ]; then
        echo "[openclaw] WARNING: same version commit mismatch (image=$image_commit current=$current_commit)"
      elif [ -f "$IMAGE_DIR/dist/entry.js" ] && [ -f "$OPENCLAW_DIR/dist/entry.js" ]; then
        local image_entry_hash=$(sha256sum "$IMAGE_DIR/dist/entry.js" | awk '{print $1}')
        local current_entry_hash=$(sha256sum "$OPENCLAW_DIR/dist/entry.js" | awk '{print $1}')
        if [ -n "$image_entry_hash" ] && [ -n "$current_entry_hash" ] && [ "$image_entry_hash" != "$current_entry_hash" ]; then
          echo "[openclaw] WARNING: same version entry hash mismatch"
        fi
      fi
    fi

    # 注意: 代码漂移检测与进入控制已由 Tower 守护进程负责。

    # 确保 bin 链接存在
    if [ ! -f "$OPENCLAW_BIN" ]; then
      ensure_openclaw_bin
    fi
  fi
}

# 初始化 workspace
init_workspace() {
  local workspace_dir="/home/node/clawd"
  local template_dir="/opt/clawd-template"

  if [ ! -f "$workspace_dir/AGENTS.md" ]; then
    echo "[openclaw] Initializing workspace from template..."
    cp -rn "$template_dir/"* "$workspace_dir/" 2>/dev/null || true
    echo "[openclaw] Workspace initialized"
  else
    echo "[openclaw] Workspace already initialized"
  fi
}

# 动态更新 AGENTS.md 中的域名
update_agents_domain() {
  local raw_domain="${LAZYCAT_APP_DOMAIN:-localhost:18789}"
  local domain=""

  if [[ "$raw_domain" == localhost* ]] || [[ "$raw_domain" == 127.0.0.1* ]]; then
    domain="http://${raw_domain}"
  else
    domain="https://${raw_domain}"
  fi

  echo "[openclaw] Updating AGENTS.md with domain: $domain"

  if [ -f "$AGENTS_MD" ]; then
    sed -i "s|{{CLAWDBOT_DOMAIN}}|${domain}|g" "$AGENTS_MD"
  fi
}

# 自动备份配置（每次启动时）
backup_config() {
  local backup_dir="${CONFIG_DIR}/backups"
  local backup_file="${backup_dir}/openclaw.json.$(date +%Y%m%d_%H%M%S)"
  local latest_backup="${CONFIG_DIR}/openclaw.json.bak"

  if [ ! -f "$CONFIG_FILE" ]; then
    return 0
  fi

  mkdir -p "$backup_dir"

  # 复制到带时间戳的备份
  cp "$CONFIG_FILE" "$backup_file"
  echo "[openclaw] Config backed up to: $backup_file"

  # 同时更新最新备份（供恢复按钮使用）
  cp "$CONFIG_FILE" "$latest_backup"

  # 保留最近10个备份
  ls -1t "$backup_dir"/openclaw.json.* 2>/dev/null | tail -n +11 | xargs -r rm -f
}

# 初始化配置
init_config() {
  if [ -f "$CONFIG_FILE" ]; then
    echo "[openclaw] Configuration exists at $CONFIG_FILE"
    # 自动备份现有配置
    backup_config
    return 0
  fi

  echo "[openclaw] Generating initial configuration..."
  mkdir -p "$CONFIG_DIR"

  cat "$IMAGE_DIR/default-config.json" > "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
  echo "[openclaw] Initial configuration created at $CONFIG_FILE"
}

# 显示版本
init_openclaw
echo "[openclaw] Version: $(openclaw --version 2>/dev/null || echo 'unknown')"
echo "[openclaw] Use 'openclaw update' to update (changes persist across restarts)"

# 默认命令
CMD="${1:-gateway}"

case "$CMD" in
  gateway)
    init_workspace
    update_agents_domain
    init_config
    # 启动 Tower 守护进程，它会内部启动 OpenClaw 并提供健康监控和恢复界面
    exec /usr/local/bin/tower --port 8800 --openclaw-port 18789 --config "$CONFIG_FILE"
    ;;
  tower)
    # 直接启动 tower（用于调试）
    init_workspace
    update_agents_domain
    init_config
    shift
    exec /usr/local/bin/tower "$@"
    ;;
  *)
    init_workspace
    update_agents_domain
    exec openclaw "$@"
    ;;
esac
EOF

EXPOSE 8800
EXPOSE 18789
EXPOSE 18792

CMD ["gateway"]
ENTRYPOINT ["/usr/local/bin/clawdbot-entrypoint.sh"]
