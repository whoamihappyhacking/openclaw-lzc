FROM node:22-bookworm

# 配置清华源
RUN sed -i 's|http://deb.debian.org|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources && \
    sed -i 's|http://security.debian.org|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources

# 复制预下载的 Bun 二进制
COPY scripts/bun-linux-x64/bun /usr/local/bin/bun
RUN chmod +x /usr/local/bin/bun && ln -sf /usr/local/bin/bun /usr/local/bin/bunx
ENV PATH="/usr/local/bin:${PATH}"

RUN corepack enable

# ========== 安装 Chromium 和浏览器依赖 ==========
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    chromium \
    chromium-driver \
    fonts-liberation \
    fonts-noto-color-emoji \
    fonts-noto-cjk \
    fonts-wqy-microhei \
    fonts-wqy-zenhei \
    locales \
    wget \
    unzip \
    tmux \
    sudo \
    git \
    jq \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# 配置中文 locale
RUN sed -i '/zh_CN.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen zh_CN.UTF-8
ENV LANG=zh_CN.UTF-8
ENV LC_ALL=zh_CN.UTF-8

# 设置 Chromium 路径环境变量
ENV CHROMIUM_PATH=/usr/bin/chromium

# ========== 可选的额外 apt 包 ==========
ARG CLAWDBOT_DOCKER_APT_PACKAGES=""
RUN if [ -n "$CLAWDBOT_DOCKER_APT_PACKAGES" ]; then \
      apt-get update && \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $CLAWDBOT_DOCKER_APT_PACKAGES && \
      apt-get clean && \
      rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*; \
    fi

# ========== 复制代码到模板目录（只读，用于初始化） ==========
WORKDIR /opt/openclaw-image

# 复制 package.json 等配置文件
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc openclaw.mjs ./
COPY ui/package.json ./ui/package.json
COPY patches ./patches

# 复制本地 node_modules（已在宿主机安装好）
COPY node_modules ./node_modules
COPY ui/node_modules ./ui/node_modules

# 复制源码和构建产物
COPY src ./src
COPY dist ./dist
COPY docs ./docs
COPY extensions ./extensions
COPY skills ./skills
COPY assets ./assets
COPY git-hooks ./git-hooks

# 设置 npm 全局安装目录到持久化卷
ENV NPM_CONFIG_PREFIX=/app/npm-global
ENV PATH=/app/npm-global/bin:$PATH

# ========== 配置运行环境 ==========
WORKDIR /home/node

ENV NODE_ENV=production
ENV OPENCLAW_STATE_DIR=/home/node/.openclaw

# 配置用户权限
RUN echo "node ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    mkdir -p /home/node/.openclaw && \
    chown -R node:node /home/node

# 配置 PATH 让所有 shell 会话都能使用 openclaw 命令
RUN echo 'export NPM_CONFIG_PREFIX=/app/npm-global' > /etc/profile.d/openclaw.sh && \
    echo 'export PATH=/app/npm-global/bin:$PATH' >> /etc/profile.d/openclaw.sh && \
    chmod +x /etc/profile.d/openclaw.sh

# 配置 tmux (默认启用鼠标模式支持滚动，可通过 UI 切换)
RUN printf '%s\n' \
    'set -g mouse on' \
    'set -g history-limit 50000' \
    'set -g default-terminal "xterm-256color"' \
    > /home/node/.tmux.conf

# 复制预配置的 workspace 文件
COPY --chown=node:node docker-workspace/ /opt/clawd-template/
COPY --chown=node:node docker-workspace/ /home/node/clawd/

# 添加启动脚本
COPY --chmod=755 <<'EOF' /usr/local/bin/clawdbot-entrypoint.sh
#!/bin/bash
set -e

# ========== 路径配置 ==========
IMAGE_DIR="/opt/openclaw-image"
NPM_GLOBAL="/app/npm-global"
OPENCLAW_DIR="$NPM_GLOBAL/lib/node_modules/openclaw"
OPENCLAW_BIN="$NPM_GLOBAL/bin/openclaw"

CONFIG_DIR="${OPENCLAW_STATE_DIR:-/home/node/.openclaw}"
CONFIG_FILE="${CONFIG_DIR}/openclaw.json"
AGENTS_MD="/home/node/clawd/AGENTS.md"

export OPENCLAW_STATE_DIR="$CONFIG_DIR"
export NPM_CONFIG_PREFIX="$NPM_GLOBAL"
export PATH="$NPM_GLOBAL/bin:$PATH"

echo "[openclaw] Running as root user..."

# ========== 初始化 openclaw 到持久化卷 ==========
init_openclaw() {
  # 从镜像获取版本
  local image_version=$(grep '"version"' "$IMAGE_DIR/package.json" | head -1 | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')

  if [ ! -f "$OPENCLAW_DIR/package.json" ]; then
    echo "[openclaw] First run, initializing from image (v$image_version)..."
    mkdir -p "$NPM_GLOBAL/lib/node_modules" "$NPM_GLOBAL/bin"
    cp -r "$IMAGE_DIR" "$OPENCLAW_DIR"
    ln -sf "$OPENCLAW_DIR/openclaw.mjs" "$OPENCLAW_BIN"
    echo "[openclaw] Initialized successfully"
  else
    # 检查版本
    local current_version=$(grep '"version"' "$OPENCLAW_DIR/package.json" | head -1 | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
    echo "[openclaw] Current version: $current_version (image: $image_version)"

    # 确保 bin 链接存在
    if [ ! -f "$OPENCLAW_BIN" ]; then
      mkdir -p "$NPM_GLOBAL/bin"
      ln -sf "$OPENCLAW_DIR/openclaw.mjs" "$OPENCLAW_BIN"
    fi
  fi
}

# 初始化 workspace
init_workspace() {
  local workspace_dir="/home/node/clawd"
  local template_dir="/opt/clawd-template"

  if [ ! -f "$workspace_dir/AGENTS.md" ]; then
    echo "[openclaw] Initializing workspace from template..."
    cp -rn "$template_dir/"* "$workspace_dir/" 2>/dev/null || true
    echo "[openclaw] Workspace initialized"
  else
    echo "[openclaw] Workspace already initialized"
  fi
}

# 动态更新 AGENTS.md 中的域名
update_agents_domain() {
  local raw_domain="${LAZYCAT_APP_DOMAIN:-localhost:18789}"
  local domain=""

  if [[ "$raw_domain" == localhost* ]] || [[ "$raw_domain" == 127.0.0.1* ]]; then
    domain="http://${raw_domain}"
  else
    domain="https://${raw_domain}"
  fi

  echo "[openclaw] Updating AGENTS.md with domain: $domain"

  if [ -f "$AGENTS_MD" ]; then
    sed -i "s|{{CLAWDBOT_DOMAIN}}|${domain}|g" "$AGENTS_MD"
  fi
}

# 初始化配置
init_config() {
  if [ -f "$CONFIG_FILE" ]; then
    echo "[openclaw] Configuration exists at $CONFIG_FILE"
    return 0
  fi

  echo "[openclaw] Generating initial configuration..."
  mkdir -p "$CONFIG_DIR"

  cat > "$CONFIG_FILE" <<CFGEOF
{
  "models": {
    "mode": "merge",
    "providers": {
      "Anthropic Claude": {
        "baseUrl": "https://axy5920-cliproxyapi.hf.space/v1",
        "api": "openai-completions",
        "auth": "token",
        "authHeader": true,
        "models": [
          {
            "id": "gemini-claude-sonnet-4-5",
            "name": "gemini-claude-sonnet-4-5",
            "api": "openai-completions",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 25000000,
            "maxTokens": 4096
          }
        ],
        "apiKey": "获取Key请VIP群联系"
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/clawd",
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      },
      "model": {
        "primary": "Anthropic Claude/gemini-claude-sonnet-4-5"
      }
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "gateway": {
    "mode": "local",
    "trustedProxies": ["0.0.0.0/0", "::/0"],
    "controlUi": {
      "allowInsecureAuth": true,
      "dangerouslyDisableDeviceAuth": true,
      "injectToken": true,
      "allowedOrigins": ["*"]
    },
    "auth": {
      "mode": "token",
      "token": "admin"
    }
  },
  "canvasHost": {
    "root": "/home/node/clawd/canvas"
  },
  "browser": {
    "enabled": true,
    "headless": true,
    "noSandbox": true,
    "defaultProfile": "clawd",
    "executablePath": "/usr/bin/chromium"
  }
}
CFGEOF
  chmod 600 "$CONFIG_FILE"
  echo "[openclaw] Initial configuration created at $CONFIG_FILE"
}

# 显示版本
init_openclaw
echo "[openclaw] Version: $(openclaw --version 2>/dev/null || echo 'unknown')"
echo "[openclaw] Use 'openclaw update' to update (changes persist across restarts)"

# 默认命令
CMD="${1:-gateway}"

case "$CMD" in
  gateway)
    init_workspace
    update_agents_domain
    init_config
    exec openclaw "$@"
    ;;
  *)
    init_workspace
    update_agents_domain
    exec openclaw "$@"
    ;;
esac
EOF

EXPOSE 18789
EXPOSE 18792
EXPOSE 18800

CMD ["gateway", "--bind", "lan", "--port", "18789"]
ENTRYPOINT ["/usr/local/bin/clawdbot-entrypoint.sh"]
